load("@rules_go//go:def.bzl", "go_binary", "go_library")

# Build script to build frontend before Go binary
genrule(
    name = "build_frontend_script",
    outs = ["build_frontend.sh"],
    cmd = """
cat > $@ << 'EOF'
#!/bin/bash
set -e
cd examples/react/frontend
echo "Building React frontend..."
npm install --silent
npm run build
echo "Frontend built successfully to examples/react/dist/"
EOF
chmod +x $@
    """,
    executable = True,
    visibility = ["//visibility:public"],
)

go_library(
    name = "react_lib",
    srcs = ["main.go"],
    # Frontend is built by //examples/react/frontend:build_react
    # It monitors src/ for changes and rebuilds when needed
    embedsrcs = [
        "//examples/react/frontend:dist",
        ":dist_for_embed",
    ] + glob([
        "migrations/*.sql",
    ]),
    importpath = "github.com/Waryway/Wayframe/examples/react",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/web",
        "//internal/web/stdlib",
        "//pkg/database",
    ],
)

# Genrule to copy frontend outputs into this package's dist/ so go:embed "dist/*" works
genrule(
    name = "dist_for_embed",
    srcs = ["//examples/react/frontend:dist"],
    outs = ["dist/index.html", "dist/bundle.js"],
    cmd_bash = """
set -euo pipefail
# Bazel expands OUTS into a space-separated list
OUTS_STR="$(OUTS)"
IFS=' ' read -r OUT_HTML OUT_JS <<< "$OUTS_STR" || true
# Get the frontend filegroup files (expanded by Bazel via locations())
FILES="$(locations //examples/react/frontend:dist)"
# Find index.html and a JS bundle
INDEX_FILE=$(echo "$FILES" | tr ' ' '\n' | grep -E '/index.html$' | head -n 1 || true)
JS_FILE=$(echo "$FILES" | tr ' ' '\n' | grep -E '\.js$' | head -n 1 || true)
if [ -z "$INDEX_FILE" ]; then
  echo "index.html not found in frontend dist files: $FILES" >&2
  exit 1
fi
mkdir -p "$(dirname "$OUT_HTML")"
cp "$INDEX_FILE" "$OUT_HTML"
if [ -n "$JS_FILE" ]; then
  mkdir -p "$(dirname "$OUT_JS")"
  cp "$JS_FILE" "$OUT_JS"
fi
""",
    local = 1,
    visibility = ["//visibility:public"],
)

go_binary(
    name = "react",
    embed = [":react_lib"],
    visibility = ["//visibility:public"],
)
