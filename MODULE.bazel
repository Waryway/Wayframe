module(
    name = "wayframe",
    version = "0.1.0",
)

# Bazel dependencies
bazel_dep(name = "rules_go", version = "0.58.2")
bazel_dep(name = "gazelle", version = "0.45.0")
bazel_dep(name = "aspect_rules_js", version = "2.7.0")
bazel_dep(name = "aspect_rules_ts", version = "3.2.1")
bazel_dep(name = "aspect_rules_webpack", version = "0.17.1")

# Configure rules_go to download and build with a specific version of Go.
#
# use_extension here loads the go_sdk Bazel module extension.
# A module extension is a bit of code that tells Bazel how to fetch things
# that aren't normal modules.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.0")

# Configure Gazelle to load the list of Go modules from go.mod using the
# go_deps module extension.
#
# go_deps fetches Go modules using 'go mod download'. It then generates
# build files for them using Gazelle.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_alecthomas_kong", "com_github_gofiber_fiber_v2", "com_github_gorilla_mux", "com_github_spf13_cobra", "in_gopkg_yaml_v3")

# Node.js toolchain for JavaScript builds
nodejs = use_extension("@aspect_rules_js//js:extensions.bzl", "nodejs")
nodejs.toolchain(node_version = "20.11.0")

# Use pnpm for JS package management with lockfile
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "pnpm_react",
    pnpm_lock = "//:pnpm-lock.yaml",
    npmrc = "//:.npmrc",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "pnpm_react")

# Register pnpm version (optional override)
pnpm_ext = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm_ext.pnpm(name = "pnpm")
